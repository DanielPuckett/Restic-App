# SMTP settings for the prune_job.py report email.
# Copy to /mnt/restic_tui/.env on the backup server and chmod 600 it.
# Never commit the real file.
# Comments must be on their own line; text after a value is part of the value.

SMTP_HOST=smtp.example.com

# 587 = STARTTLS, 465 = implicit TLS
SMTP_PORT=587

# Leave SMTP_USER empty to skip login (for example a local relay)
SMTP_USER=username
SMTP_PASS=change-me

SMTP_FROM=noreply@example.com

# Comma-separated for several recipients
SMTP_TO=you@example.com
